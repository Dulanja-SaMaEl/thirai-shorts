# Node.js Server Config
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://thirai-plus.vercel.app

# Supabase PostgreSQL Configuration
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Cloudflare R2 Direct S3-Compatible Object Storage
# Found in Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=thirai-plus-media
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://pub-your-bucket-id.r2.dev

# Stripe Payments Integration
# Found in Stripe Dashboard -> Developers -> API Keys / Webhooks
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
SUBMISSION_FEE_CENTS=2500
